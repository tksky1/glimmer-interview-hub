# ===== 微光面试预约平台 环境变量 =====
# 复制为 .env 后按需修改：cp .env.example .env

# Web 服务对外端口，预览访问 http://localhost:WEB_PORT/interview/
WEB_PORT=8081

# JWT 签名密钥：本地验签快路径使用。旧系统线上部署的密钥可能与此不同，
# 不一致时自动降级为「委派旧系统 API 校验」，无需修改此项。
JWT_SECRET=RecruitmentSystem

# 旧系统 API 地址（委派校验 token 用，需容器可访问）
LEGACY_API_BASE=https://api.glimmer.org.cn

# 初始管理员用户名（旧系统登录名，多个用英文逗号分隔，例如 alice,bob）
# 留空则启动时无管理员，可在管理后台由已有管理员添加（首个管理员需在此指定）
ADMIN_USERNAMES=
